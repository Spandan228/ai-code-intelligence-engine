# ==========================================
# AI Code Intelligence Engine Configuration
# ==========================================

# API Server Settings
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false

# Streamlit Dashboard Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Embedding Model Settings
# Default: all-MiniLM-L6-v2 (384-dimensional dense vector embeddings)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Storage & Index Paths
DATA_DIR=data
INDEX_DIR=data/indices
FAISS_INDEX_FILE=data/indices/code_embeddings.index
METADATA_FILE=data/indices/code_metadata.pkl

# Logging
LOG_LEVEL=INFO
